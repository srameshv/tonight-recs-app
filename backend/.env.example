# Database (SQLite for local dev; swap to a Postgres URL before deploy)
DATABASE_URL=sqlite:///./tonight.db

# Ingestion sources
TMDB_API_KEY=
GOOGLE_PLACES_API_KEY=

# Judgment/generation providers
